<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DocumentCompare.Avalonia.Views.MainWindow"
        Width="1700" Height="980" MinWidth="1050" MinHeight="680"
        Icon="/Assets/DocumentCompare.ico"
        Background="#F7F9FC"
        Title="문서 비교기 V5.21.7">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="12">
    <Menu Grid.Row="0" Margin="-4,-4,-4,8" Background="Transparent">
      <MenuItem x:Name="HelpMenuItem" Header="도움말">
        <MenuItem x:Name="QuickGuideMenuItem" Header="간단 사용설명서" Click="QuickGuide_Click"/>
      </MenuItem>
      <MenuItem x:Name="LanguageMenuItem" Header="언어">
        <MenuItem x:Name="KoreanLanguageMenuItem" Header="✓ 한국어 (KR)" Click="KoreanLanguage_Click"/>
        <MenuItem x:Name="EnglishLanguageMenuItem" Header="English (EN)" Click="EnglishLanguage_Click"/>
      </MenuItem>
    </Menu>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="2,0,2,10">
      <TextBlock x:Name="AppTitleText" Grid.Column="0" Text="문서 비교기"
                 FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,22,0"/>
      <Button x:Name="QuickCompareModeButton" Grid.Column="1" Classes="primaryAction" Content="빠른 비교"
              MinWidth="100" HorizontalContentAlignment="Center" Click="QuickCompareMode_Click"/>
      <Button x:Name="VersionHistoryModeButton" Grid.Column="2" Classes="secondaryAction" Content="버전 관리"
              MinWidth="100" Margin="8,0,0,0" HorizontalContentAlignment="Center" Click="VersionHistoryMode_Click"/>
      <Border Grid.Column="4" Classes="statusPill" VerticalAlignment="Center">
        <TextBlock x:Name="StatusText" Text="준비됨" FontSize="12.5"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="720"/>
      </Border>
    </Grid>

    <Grid x:Name="QuickCompareWorkspace" Grid.Row="2" Grid.RowSpan="3" RowDefinitions="Auto,Auto,*">
    <Border Grid.Row="0" Classes="toolbarSurface" Margin="0,0,0,8">
      <Grid RowDefinitions="Auto,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*">
          <Button x:Name="CompareButton" Grid.Column="0" Classes="primaryAction"
                  Content="비교 시작" MinWidth="112" HorizontalContentAlignment="Center" Click="Compare_Click"/>
          <Button x:Name="CancelButton" Grid.Column="1" Classes="subtleAction"
                  Content="취소" Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click"/>
          <Button x:Name="ExcelButton" Grid.Column="2" Classes="secondaryAction"
                  Content="Excel 내보내기" Margin="16,0,0,0" IsEnabled="False" Click="Excel_Click"/>
          <Button x:Name="WordButton" Grid.Column="3" Classes="secondaryAction"
                  Content="Word 변경추적" Margin="8,0,0,0" IsEnabled="False" Click="Word_Click"/>
          <Button x:Name="AddCButton" Grid.Column="4" Classes="secondaryAction"
                  Content="+ C 문서 추가" Margin="16,0,0,0" Click="AddC_Click"/>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,130,Auto,Auto,*,Auto,260" Margin="0,10,0,0">
          <TextBlock x:Name="ModeLabel" Grid.Column="0" Text="비교 방식" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#475569"/>
          <ComboBox x:Name="ModeBox" Grid.Column="1" Classes="toolbarControl" SelectedIndex="0">
            <ComboBoxItem x:Name="ModeAutoItem" Content="자동"/>
            <ComboBoxItem x:Name="ModeGeneralItem" Content="일반 문서"/>
            <ComboBoxItem x:Name="ModeLegalItem" Content="법률·규정"/>
          </ComboBox>
          <CheckBox x:Name="PunctuationBox" Grid.Column="2" Content="특수문자 포함" Margin="16,0,0,0"
                    VerticalAlignment="Center" IsChecked="True"/>
          <CheckBox x:Name="CompareACBox" Grid.Column="3" Content="A↔C 추가 비교" Margin="16,0,0,0"
                    VerticalAlignment="Center" IsEnabled="False" IsVisible="False"/>
          <TextBlock x:Name="SearchLabel" Grid.Column="5" Text="검색" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#475569"/>
          <TextBox x:Name="SearchBox" Grid.Column="6" Classes="searchBox"
                   PlaceholderText="본문/변경사항 검색" TextChanged="SearchBox_TextChanged"/>
        </Grid>
      </Grid>
    </Border>

    <ProgressBar x:Name="CompareProgress" Grid.Row="1" Height="5" Minimum="0" Maximum="100" Value="0"
                 IsVisible="False" Margin="2,0,2,8"/>

    <Border Grid.Row="2" Classes="resultFrame" ClipToBounds="True">
      <Grid x:Name="ResultArea" RowDefinitions="Auto,*" ClipToBounds="True">
        <Grid x:Name="ComparisonHeader" Grid.Row="0" Height="50" ColumnDefinitions="5*,2*" Background="#EAF0F6">
          <Grid x:Name="DocumentHeaderGrid" Grid.Column="0" ColumnDefinitions="*,*,0">
            <Border Grid.Column="0" BorderBrush="#B9C6D4" BorderThickness="0,0,1,1" Background="#EAF0F6">
              <Grid ColumnDefinitions="*,Auto">
                <Border x:Name="DropA" Grid.Column="0" Background="Transparent" DragDrop.AllowDrop="True"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                  <Button x:Name="ChooseAButton" Classes="documentHeaderButton" Background="Transparent" BorderThickness="0" Padding="12,6"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Click="ChooseA_Click">
                    <TextBlock x:Name="HeaderAText" Text="A · 파일 선택 또는 드롭" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </Button>
                </Border>
                <RadioButton x:Name="BaseA" Grid.Column="1" GroupName="baseDoc" Content="기준" IsChecked="True"
                             Margin="8,0,12,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <Border Grid.Column="1" BorderBrush="#B9C6D4" BorderThickness="0,0,1,1" Background="#EAF0F6">
              <Grid ColumnDefinitions="*,Auto">
                <Border x:Name="DropB" Grid.Column="0" Background="Transparent" DragDrop.AllowDrop="True"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                  <Button x:Name="ChooseBButton" Classes="documentHeaderButton" Background="Transparent" BorderThickness="0" Padding="12,6"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Click="ChooseB_Click">
                    <TextBlock x:Name="HeaderBText" Text="B · 파일 선택 또는 드롭" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </Button>
                </Border>
                <RadioButton x:Name="BaseB" Grid.Column="1" GroupName="baseDoc" Content="기준"
                             Margin="8,0,12,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <Border Grid.Column="2" BorderBrush="#B9C6D4" BorderThickness="0,0,1,1" Background="#EAF0F6">
              <Grid ColumnDefinitions="*,Auto">
                <Border x:Name="DropC" Grid.Column="0" Background="Transparent" DragDrop.AllowDrop="True"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="False">
                  <Button x:Name="ChooseCButton" Classes="documentHeaderButton" Background="Transparent" BorderThickness="0" Padding="12,6"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Click="ChooseC_Click">
                    <TextBlock x:Name="HeaderCText" Text="C · 추가 (선택)" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </Button>
                </Border>
                <RadioButton x:Name="BaseC" Grid.Column="1" GroupName="baseDoc" Content="기준"
                             Margin="8,0,12,0" VerticalAlignment="Center" IsVisible="False"/>
              </Grid>
            </Border>
          </Grid>

          <Border Grid.Column="1" BorderBrush="#B9C6D4" BorderThickness="0,0,0,1" Background="#F3F6FA">
            <TextBlock x:Name="ChangeHeaderText" Text="변경사항" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="SemiBold" Foreground="#334155"/>
          </Border>
        </Grid>

        <Grid x:Name="ResultBody" Grid.Row="1" IsVisible="False" ClipToBounds="True" Background="White">
          <ScrollViewer x:Name="DocumentScroll"
                        VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="RowsRepeater" HorizontalAlignment="Stretch"/>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>
    </Grid>

    <ContentControl x:Name="VersionHistoryHost" Grid.Row="2" Grid.RowSpan="3" IsVisible="False"/>
  </Grid>
</Window>
