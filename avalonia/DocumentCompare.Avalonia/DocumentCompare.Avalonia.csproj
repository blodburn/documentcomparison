<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DocumentCompare</AssemblyName>
    <RootNamespace>DocumentCompare.Avalonia</RootNamespace>
    <Version>5.20.10</Version>
    <AssemblyVersion>5.20.10</AssemblyVersion>
    <FileVersion>5.20.10</FileVersion>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <AvaloniaNameGeneratorIsEnabled>false</AvaloniaNameGeneratorIsEnabled>
    <ApplicationIcon>Assets\DocumentCompare.ico</ApplicationIcon>
    <Company>blodburn</Company>
    <Product>DocumentCompare</Product>
    <Copyright>Copyright © 2026 blodburn. All rights reserved.</Copyright>
    <!-- Avalonia 12 analyzers are built with a newer Roslyn than some .NET 8 SDKs.
         This project intentionally avoids analyzer/source-generator dependencies, so keep them off
         for stable builds on the user's existing .NET 8 SDK. -->
    <RunAnalyzers>false</RunAnalyzers>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>false</RunAnalyzersDuringLiveAnalysis>
    <NoWarn>$(NoWarn);CS9057</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\DocumentCompare.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" ExcludeAssets="analyzers" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" ExcludeAssets="analyzers" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" ExcludeAssets="analyzers" />
  </ItemGroup>
</Project>
