<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DocumentCompare</AssemblyName>
    <RootNamespace>DocumentCompare.Avalonia</RootNamespace>
    <Version>5.21.15</Version>
    <AssemblyVersion>5.21.15</AssemblyVersion>
    <FileVersion>5.21.15</FileVersion>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <AvaloniaNameGeneratorIsEnabled>false</AvaloniaNameGeneratorIsEnabled>
    <ApplicationIcon>Assets\DocumentCompare.ico</ApplicationIcon>
    <Company>blodburn</Company>
    <Product>DocumentCompare</Product>
    <Copyright>Copyright © 2026 blodburn. All rights reserved.</Copyright>
    <!-- Avalonia 12 analyzers are built with a newer Roslyn than some .NET 8 SDKs.
         This project intentionally avoids analyzer/source-generator dependencies, so keep them off
         for stable builds on the user's existing .NET 8 SDK. -->
    <RunAnalyzers>false</RunAnalyzers>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>false</RunAnalyzersDuringLiveAnalysis>
    <NoWarn>$(NoWarn);CS9057</NoWarn>
  </PropertyGroup>
  <!-- Native Rust code core is built separately and embedded as an assembly
       resource. Unlike a sidecar DLL, it remains inside single-file releases. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT')">
    <EmbeddedResource Include="../../core-rust/target/release/documentcompare_core.dll"
      LogicalName="DocumentCompare.Native.win-x64.documentcompare_core.dll"
      Condition="Exists('../../core-rust/target/release/documentcompare_core.dll')" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or ('$(RuntimeIdentifier)' == '' And '$(OS)' != 'Windows_NT')">
    <EmbeddedResource Include="../../core-rust/target/release/libdocumentcompare_core.so"
      LogicalName="DocumentCompare.Native.linux-x64.libdocumentcompare_core.so"
      Condition="Exists('../../core-rust/target/release/libdocumentcompare_core.so')" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\DocumentCompare.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" ExcludeAssets="analyzers" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" ExcludeAssets="analyzers" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" ExcludeAssets="analyzers" />
  </ItemGroup>
</Project>
