<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DocumentCompare.Avalonia.App">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button.marker">
      <Setter Property="MinWidth" Value="20"/>
      <Setter Property="MinHeight" Value="18"/>
      <Setter Property="Padding" Value="3,0"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="CornerRadius" Value="3"/>
    </Style>

    <Style Selector="Border.toolbarSurface">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D8E0EA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10"/>
    </Style>
    <Style Selector="Border.statusPill">
      <Setter Property="Background" Value="#EEF3F8"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="10,4"/>
    </Style>
    <Style Selector="Border.resultFrame">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#CBD5E1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.primaryAction">
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#1D4ED8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="16,7"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primaryAction:pointerover">
      <Setter Property="Background" Value="#1D4ED8"/>
    </Style>
    <Style Selector="Button.secondaryAction">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#334155"/>
      <Setter Property="BorderBrush" Value="#CBD5E1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style Selector="Button.secondaryAction:pointerover">
      <Setter Property="Background" Value="#F1F5F9"/>
      <Setter Property="BorderBrush" Value="#94A3B8"/>
    </Style>
    <Style Selector="Button.subtleAction">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#475569"/>
      <Setter Property="BorderBrush" Value="#D8E0EA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style Selector="Button.documentHeaderButton:pointerover">
      <Setter Property="Background" Value="#EAF0F7"/>
    </Style>
    <Style Selector="TextBox.searchBox">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="ComboBox.toolbarControl">
      <Setter Property="MinHeight" Value="32"/>
    </Style>

    <Style Selector="Border.documentCard">
      <Setter Property="BorderBrush" Value="#B8C2CF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="9"/>
      <Setter Property="Background" Value="#FBFCFE"/>
    </Style>
    <Style Selector="Border.dropCard:pointerover">
      <Setter Property="Background" Value="#F4F8FC"/>
      <Setter Property="BorderBrush" Value="#7D90A7"/>
    </Style>
  </Application.Styles>
</Application>
