<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RunAnalyzers>false</RunAnalyzers>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <NoWarn>$(NoWarn);CS9057</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../avalonia/DocumentCompare.Avalonia/DocumentCompare.Avalonia.csproj" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <None Include="Fixtures/document_parts_golden.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures/document_match_exact_golden.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures/document_move_candidates_golden.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
